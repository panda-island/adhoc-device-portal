# Copy to .env; never commit .env. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Defaults to mock; partial Apple configuration fails instead of falling back.
APPLE_MODE=mock
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# Absolute path OUTSIDE this repository to an ES256 team API .p8 key
APPLE_PRIVATE_KEY_PATH=
APPLE_BUNDLE_ID_RESOURCE=
APPLE_CERTIFICATE_RESOURCE=
